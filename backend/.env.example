# Copy to `backend/.env` and fill in. `.env` is gitignored; never commit a real
# key. Every value below is read by `llm_picker_backend/settings.py` through
# small `env*()` helpers, and every one of them has a working default -- the
# file exists so the overridable set is discoverable, not because the app
# requires it.

# --------------------------------------------------------------------------- #
# External sources
# --------------------------------------------------------------------------- #

# Artificial Analysis API v2 key, sent as `x-api-key`.
# Get one at https://artificialanalysis.ai/ -- the free tier allows 100
# requests/24h SHARED ACROSS EVERY KEY IN THE ORGANISATION. A full refresh costs
# 4 requests, twice a day, so a healthy install uses 8/day.
#
# Leave this empty and everything still runs: only the AA refresh fails, the
# read-only API keeps serving whatever is already stored, and `/metadata/`
# reports `"configured": false` for that source.
AA_API_KEY=

# Override only to point at a mock or a pinned upstream.
# AA_BASE_URL=https://artificialanalysis.ai/api/v2
# LEADERBOARD_LMARENA_DATASET=lmarena-ai/leaderboard-dataset

# --------------------------------------------------------------------------- #
# Hacker News discussions
# --------------------------------------------------------------------------- #
#
# No key is required: the Algolia Hacker News search API is open, so there is
# nothing to fill in here and no `configured: false` state to report. Every value
# below has a working default; this section exists so the overridable set is
# discoverable.
#
# The refresh runs hourly from the same Celery beat as the model refresh, at :15
# (offset from the twice-daily run's :00 so two writers never collide on one
# SQLite file). Steady-state cost is ~25-40 requests/hour against a documented
# allowance of 10,000.

# Master switch. `false` removes the schedule entry AND short-circuits inside the
# task, because django-celery-beat's DatabaseScheduler keeps an existing
# PeriodicTask row alive after the code entry is gone.
# LEADERBOARD_HN_ENABLED=true

# Retention. Threads older than this are DELETED along with their comments -- the
# one place this app deletes a source table. That is safe here because a Hacker
# News thread stays fetchable upstream forever, so our row is a re-fetchable cache
# entry rather than the last copy of a measurement. See docs/data-sources.md.
# LEADERBOARD_HN_WINDOW_DAYS=14
#
# The window is queried in slices this wide. Algolia cannot page past 1,000
# results and past that returns a plausible-looking *truncated* set, so one query
# per fortnight would silently lose its oldest days. Must be <= the window.
# LEADERBOARD_HN_WINDOW_SLICE_DAYS=7

# The floor a story must clear, applied server-side through `numericFilters` --
# which is what makes a window cost a handful of requests instead of one per story.
# LEADERBOARD_HN_MIN_POINTS=100
# LEADERBOARD_HN_MIN_COMMENTS=20

# The floor a *keyword-swept* story must clear, deliberately lower. Two different
# questions: the window floor asks "is this one of the notable stories of the
# period?", the sweep floor asks "is this a real discussion rather than trivia?".
# The sweep exists to reach what the window floor excludes, so reusing that floor
# here would make it find nothing new.
#
# This is ALSO the bar a thread must clear to remain in the bank: the hourly prune
# removes anything below it, so the floors stay the retention policy rather than a
# rule applied once at discovery. Raising them is therefore retroactive -- which
# `--dry-run` shows as `threads_below_floor` before anything is deleted.
# LEADERBOARD_HN_SWEEP_MIN_POINTS=30
# LEADERBOARD_HN_SWEEP_MIN_COMMENTS=5

# `rank_score = points + weight * num_comments`. A comment is evidence of
# engagement, which is this feature's whole subject.
# LEADERBOARD_HN_COMMENT_WEIGHT=1.0

# Per-run tree budget, and the wall-clock ceiling on the tree-fetch phase.
# Whatever is not reached is deferred to the next hour and reported: an hourly job
# that overran its own interval would collide with itself.
#
# The budget is sized for the *cold start*, not for the steady state. Discovery
# finds several hundred LLM-related threads in its first pass over a retention
# window, while a settled hour adds only tens -- so a budget near the steady-state
# rate leaves the initial backlog pending for days, showing as "no comments yet"
# on most rows. At a measured ~4s per tree, 60 is ~4 minutes of a 600s budget.
# LEADERBOARD_HN_MAX_TREES_PER_RUN=60
# LEADERBOARD_HN_RUN_BUDGET_SECONDS=600

# Keyword sweeps per run. Terms are swept round-robin, so cost stays constant per
# hour however large the vocabulary grows; set 0 to disable the sweep entirely.
# LEADERBOARD_HN_KEYWORD_QUERY_BUDGET=8

# Search pagination. `hits_per_page * max_page` must stay under Algolia's 1,000
# result ceiling; `manage.py check` asserts the arithmetic at boot.
# LEADERBOARD_HN_HITS_PER_PAGE=100
# LEADERBOARD_HN_MAX_PAGE=9

# Two different questions: the first refuses a thread before spending a request on
# it, the second caps how much of any fetched tree is kept. The stored cap must be
# at or below the refusal, or it could never bind.
#
# The refusal is generous on purpose. It guards download size only -- storage is
# already bounded by the stored cap -- and the busiest threads on Hacker News
# routinely pass 1,500 comments, so a tight refusal would drop exactly the
# discussions most worth reading. The Content-Length ceiling below is the real
# limit on how much is ever downloaded.
#
# The gap between the two decides the largest discussion that can be shown *at
# all*: a thread above the refusal stores no comments, and every run skips it, so
# it reads in the UI like one whose tree has simply not been fetched yet.
# LEADERBOARD_HN_MAX_COMMENTS=3000
# LEADERBOARD_HN_MAX_STORED_COMMENTS=2500

# Byte ceiling checked from Content-Length before the body is read. A response
# without that header cannot be checked here, which is why the comment cap above
# exists as a second guard.
# LEADERBOARD_HN_MAX_ITEM_BYTES=8000000

# Comment trees are far larger than search responses, so they get their own
# timeout rather than sharing the 30s the search path uses.
# LEADERBOARD_HN_TREE_TIMEOUT_SECONDS=45.0

# A 429 with a Retry-After longer than this fails the run rather than sleeping
# through it inside a worker; the next hourly run picks it up.
# LEADERBOARD_HN_MAX_INLINE_RETRY_AFTER_SECONDS=60

# Staleness for `meta.discussions`. The job runs hourly, so two hours tolerates one
# missed run. Deliberately NOT folded into `meta.sources`, which describes the
# model rows a response carries.
# LEADERBOARD_HN_STALE_AFTER_SECONDS=7200

# --------------------------------------------------------------------------- #
# Django
# --------------------------------------------------------------------------- #

# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# DEBUG=true also enables a permissive CORS origin regex for any localhost dev
# port, so a second `npm run dev` (5174, 5175, ...) does not fail CORS.
DJANGO_DEBUG=true

# Comma-separated. Ignored when DJANGO_DEBUG=true and the list is empty.
DJANGO_ALLOWED_HOSTS=

# Comma-separated origins for the D3 frontend.
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------------------- #
# Redis (Celery broker, result backend, and the refresh overlap lock)
# --------------------------------------------------------------------------- #

# The broker uses /0, results /1 and the lock cache /2, all derived from this.
REDIS_URL=redis://127.0.0.1:6379

# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# The zone `CELERY_BEAT_SCHEDULE` is expressed in. Must be a real IANA name --
# the scaffold shipped "China/Shanghai", which `ZoneInfo` rejects outright and
# which stops Celery beat from starting. The twice-daily crontab is
# `minute=0, hour="8,20"`, i.e. 00:00 and 12:00 UTC.
CELERY_TIMEZONE=Asia/Shanghai

# --------------------------------------------------------------------------- #
# Ingestion tuning
# --------------------------------------------------------------------------- #

# Seconds a source may go unrefreshed before `/metadata/` reports it stale. The
# schedule runs twice daily, so the default tolerates one missed run.
# LEADERBOARD_STALE_AFTER_SECONDS=50400

# The single inferred join in the match ladder: strips one trailing
# evaluation-harness token (`codex-harness`) when it yields a unique, unshadowed
# candidate. Reasoning-effort tokens are never folded -- see the matching docs.
# Set to false to serve only exact and alias matches.
# LEADERBOARD_ENABLE_HARNESS_FOLD=true

# How long `refresh_if_stale` waits after the last attempt before trying again,
# whatever that attempt's outcome. Staleness alone is not enough on a launch
# path: a refresh that just failed is unlikely to succeed seconds later, and a
# restart loop would re-attempt on every boot -- each AA attempt spending up to 4
# of the 100 requests shared across the whole organization per day.
# `refresh_if_stale --force` ignores it. Set to 0 to disable.
# LEADERBOARD_STARTUP_REFRESH_COOLDOWN_SECONDS=1800

# LEADERBOARD_LOG_LEVEL=INFO

# --------------------------------------------------------------------------- #
# Inbound rate limiting (the public API's ceiling)
# --------------------------------------------------------------------------- #

# Two stacked per-IP budgets; a request must satisfy both. Syntax is DRF's
# `<count>/<period>`, where the period is s, m, h or d. A malformed value is
# reported by `manage.py check` rather than 500-ing every request.
#
# Set LEADERBOARD_THROTTLE_ENABLED=false to serve without limits -- useful while
# load-testing the frontend, never in a deployment.
# LEADERBOARD_THROTTLE_ENABLED=true
# LEADERBOARD_THROTTLE_BURST=60/min
# LEADERBOARD_THROTTLE_SUSTAINED=2000/day

# How many reverse proxies sit in front of the app.
#
# **This is a security setting, not a tuning knob.** At 0, `X-Forwarded-For` is
# ignored entirely and the socket peer is the client's identity -- correct while
# the app is reached directly, and the reason a client cannot escape its budget
# by sending a fabricated header. Raise it to the number of proxies you actually
# control *only* once one is deployed in front of this app; set too high, it
# starts believing a header that anyone can write.
# DJANGO_NUM_PROXIES=0

# SQLite busy timeout, in seconds. The Celery worker writes while `runserver`
# reads the same file.
# SQLITE_TIMEOUT_SECONDS=20

# Where the SQLite file lives. Defaults to `backend/db.sqlite3`, which is right
# for a laptop. In the container it must point *inside* the mounted volume, or
# the database -- and its -wal/-shm sidecars, whose names SQLite derives from
# this path -- is discarded on every recreate.
# SQLITE_PATH=/data/db.sqlite3

# Where `collectstatic` writes, served by nginx at /static/.
# DJANGO_STATIC_ROOT=/app/staticfiles

# --------------------------------------------------------------------------- #
# Deployment (docker-compose.yml). All of these are REQUIRED in production.
# --------------------------------------------------------------------------- #

# The public hostname of this API, with no scheme and no port. Used for
# ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS. Without it Django answers 400
# DisallowedHost to every proxied request -- `manage.py check --deploy` does not
# catch this, and the stack otherwise looks "up".
DOMAIN=api.example.com

# NOTE: there is no CERTBOT_EMAIL. TLS is terminated by the host's own nginx,
# which already owns :80/:443 -- Let's Encrypt's HTTP-01 challenge needs port 80,
# so an in-stack ACME client could never validate. See DEPLOYMENT.md.

# The deployed frontend's *origin*: scheme + host only. Never a path, never a
# trailing slash -- origins have no path, and the browser sends exactly this
# string. GitHub Pages project sites are served from a subpath but their origin
# is the bare domain. Only needed if it differs from the default below.
# CORS_ALLOWED_ORIGINS=https://toothlessos.github.io

