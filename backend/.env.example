# Copy to `backend/.env` and fill in. `.env` is gitignored; never commit a real
# key. Every value below is read by `llm_picker_backend/settings.py` through
# small `env*()` helpers, and every one of them has a working default -- the
# file exists so the overridable set is discoverable, not because the app
# requires it.

# --------------------------------------------------------------------------- #
# External sources
# --------------------------------------------------------------------------- #

# Artificial Analysis API v2 key, sent as `x-api-key`.
# Get one at https://artificialanalysis.ai/ -- the free tier allows 100
# requests/24h SHARED ACROSS EVERY KEY IN THE ORGANISATION. A full refresh costs
# 4 requests, twice a day, so a healthy install uses 8/day.
#
# Leave this empty and everything still runs: only the AA refresh fails, the
# read-only API keeps serving whatever is already stored, and `/metadata/`
# reports `"configured": false` for that source.
AA_API_KEY=

# Override only to point at a mock or a pinned upstream.
# AA_BASE_URL=https://artificialanalysis.ai/api/v2
# LEADERBOARD_LMARENA_DATASET=lmarena-ai/leaderboard-dataset

# --------------------------------------------------------------------------- #
# Django
# --------------------------------------------------------------------------- #

# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# DEBUG=true also enables a permissive CORS origin regex for any localhost dev
# port, so a second `npm run dev` (5174, 5175, ...) does not fail CORS.
DJANGO_DEBUG=true

# Comma-separated. Ignored when DJANGO_DEBUG=true and the list is empty.
DJANGO_ALLOWED_HOSTS=

# Comma-separated origins for the D3 frontend.
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------------------- #
# Redis (Celery broker, result backend, and the refresh overlap lock)
# --------------------------------------------------------------------------- #

# The broker uses /0, results /1 and the lock cache /2, all derived from this.
REDIS_URL=redis://127.0.0.1:6379

# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# The zone `CELERY_BEAT_SCHEDULE` is expressed in. Must be a real IANA name --
# the scaffold shipped "China/Shanghai", which `ZoneInfo` rejects outright and
# which stops Celery beat from starting. The twice-daily crontab is
# `minute=0, hour="8,20"`, i.e. 00:00 and 12:00 UTC.
CELERY_TIMEZONE=Asia/Shanghai

# --------------------------------------------------------------------------- #
# Ingestion tuning
# --------------------------------------------------------------------------- #

# Seconds a source may go unrefreshed before `/metadata/` reports it stale. The
# schedule runs twice daily, so the default tolerates one missed run.
# LEADERBOARD_STALE_AFTER_SECONDS=50400

# The single inferred join in the match ladder: strips one trailing
# evaluation-harness token (`codex-harness`) when it yields a unique, unshadowed
# candidate. Reasoning-effort tokens are never folded -- see the matching docs.
# Set to false to serve only exact and alias matches.
# LEADERBOARD_ENABLE_HARNESS_FOLD=true

# How long `refresh_if_stale` waits after the last attempt before trying again,
# whatever that attempt's outcome. Staleness alone is not enough on a launch
# path: a refresh that just failed is unlikely to succeed seconds later, and a
# restart loop would re-attempt on every boot -- each AA attempt spending up to 4
# of the 100 requests shared across the whole organization per day.
# `refresh_if_stale --force` ignores it. Set to 0 to disable.
# LEADERBOARD_STARTUP_REFRESH_COOLDOWN_SECONDS=1800

# LEADERBOARD_LOG_LEVEL=INFO

# --------------------------------------------------------------------------- #
# Inbound rate limiting (the public API's ceiling)
# --------------------------------------------------------------------------- #

# Two stacked per-IP budgets; a request must satisfy both. Syntax is DRF's
# `<count>/<period>`, where the period is s, m, h or d. A malformed value is
# reported by `manage.py check` rather than 500-ing every request.
#
# Set LEADERBOARD_THROTTLE_ENABLED=false to serve without limits -- useful while
# load-testing the frontend, never in a deployment.
# LEADERBOARD_THROTTLE_ENABLED=true
# LEADERBOARD_THROTTLE_BURST=60/min
# LEADERBOARD_THROTTLE_SUSTAINED=2000/day

# How many reverse proxies sit in front of the app.
#
# **This is a security setting, not a tuning knob.** At 0, `X-Forwarded-For` is
# ignored entirely and the socket peer is the client's identity -- correct while
# the app is reached directly, and the reason a client cannot escape its budget
# by sending a fabricated header. Raise it to the number of proxies you actually
# control *only* once one is deployed in front of this app; set too high, it
# starts believing a header that anyone can write.
# DJANGO_NUM_PROXIES=0

# SQLite busy timeout, in seconds. The Celery worker writes while `runserver`
# reads the same file.
# SQLITE_TIMEOUT_SECONDS=20

# Where the SQLite file lives. Defaults to `backend/db.sqlite3`, which is right
# for a laptop. In the container it must point *inside* the mounted volume, or
# the database -- and its -wal/-shm sidecars, whose names SQLite derives from
# this path -- is discarded on every recreate.
# SQLITE_PATH=/data/db.sqlite3

# Where `collectstatic` writes, served by nginx at /static/.
# DJANGO_STATIC_ROOT=/app/staticfiles

# --------------------------------------------------------------------------- #
# Deployment (docker-compose.yml). All of these are REQUIRED in production.
# --------------------------------------------------------------------------- #

# The public hostname of this API, with no scheme and no port. Used for
# ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS. Without it Django answers 400
# DisallowedHost to every proxied request -- `manage.py check --deploy` does not
# catch this, and the stack otherwise looks "up".
DOMAIN=api.example.com

# NOTE: there is no CERTBOT_EMAIL. TLS is terminated by the host's own nginx,
# which already owns :80/:443 -- Let's Encrypt's HTTP-01 challenge needs port 80,
# so an in-stack ACME client could never validate. See DEPLOYMENT.md.

# The deployed frontend's *origin*: scheme + host only. Never a path, never a
# trailing slash -- origins have no path, and the browser sends exactly this
# string. GitHub Pages project sites are served from a subpath but their origin
# is the bare domain. Only needed if it differs from the default below.
# CORS_ALLOWED_ORIGINS=https://toothlessos.github.io

